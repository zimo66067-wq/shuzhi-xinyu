# 后端环境变量模板
# 复制此文件为 backend/.env 并填写真实值
# backend/.env 不会提交到 Git（已在 .gitignore 中忽略）
#
# 部署到 Render 时：在 Render Dashboard → Environment 中手动填写这些值
# 不要提交真实密钥到 Git！

# ━━━ 必须 ━━━
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DeepSeek V4.1 Flash（当前稳定API标识），若要Pro改为 deepseek-v4-pro
# 对话请求显式使用非思考模式；完整参数由后端 get_model_config 冻结
DEEPSEEK_MODEL=deepseek-flash
TENCENT_SECRET_ID=AKID-your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# ━━━ 推荐修改 ━━━
# 家长端密码（生产环境务必修改默认值！）
PARENT_PASSWORD=请修改为你的强密码
# 家长 token 签名密钥（留空则使用随机生成，重启后旧 token 失效）
PARENT_SECRET=

# ━━━ 安全 ━━━
# CORS 允许的域名（逗号分隔）
# 本地开发:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vercel 部署:
#   CORS_ORIGINS=https://shuzhi-xinyu.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ━━━ 服务器 ━━━
# 监听地址（本地: 127.0.0.1，Docker/Render: 0.0.0.0）
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# 调试模式（生产环境务必设为 0）
FLASK_DEBUG=0
# Gunicorn 日志级别 (debug / info / warning / error / critical)
GUNICORN_LOG_LEVEL=info
# 请求体大小上限（字节），默认 1MB。Render 部署应设为 8388608（8MB）以支持 STT 音频上传
FLASK_MAX_CONTENT_LENGTH=1048576

# 科研实验默认关闭。与普通训练数据隔离；正式实验应使用独立后端和独立数据库。
EXPERIMENT_ENABLED=0
EXPERIMENT_ENV=pilot
# 明确指定文件路径；示例仅供本地试运行。正式运行必须挂载可靠持久卷。
EXPERIMENT_DB=/absolute/path/to/experiment-data/pilot.sqlite3
EXPERIMENT_HUMAN_VERIFICATION=supervised
# 正式环境另设 EXPERIMENT_ENV=formal，以下两项必须由维护者实际核查后填写：
# EXPERIMENT_DURABLE_ROOT=/mounted/persistent/volume
# EXPERIMENT_STORAGE_ACK=persistent-single-host
EXPERIMENT_REPLICAS=1
# 无 .git 的发布包须填写实际完整40位提交SHA，不是自定义版本名。
EXPERIMENT_SOFTWARE_COMMIT=
# 可选 Turnstile；大陆客户端和服务端网络均验收后才切换验证模式。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
